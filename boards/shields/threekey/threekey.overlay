/*
 * ThreeKey Keyboard - MINIMAL DEBUG build
 * OLED and EC11 disabled to isolate boot hang
 */

#include <dt-bindings/gpio/gpio.h>


/ {
    chosen {
        zmk,kscan = &kscan;
        zephyr,console = &cdc_acm_uart;
    };


    kscan: kscan {

        compatible = "zmk,kscan-gpio-direct";

        wakeup-source;


        input-gpios = <
            &gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
            &gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
            &gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
            &gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
        >;

    };

};



&usbd {

    cdc_acm_uart: zephyr,cdc-acm-uart {

        compatible = "zephyr,cdc-acm-uart";

    };

};
